{
  "manifest_version": 3,
  "name": "密钥库",
  "version": "0.1.6",
  "description": "密钥库的浏览器助手：识别登录框、右键一键填充、提交后提示保存。所有数据仍由桌面端本机加密存储。",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}